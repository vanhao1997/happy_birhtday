# Server-side Supabase config. Do not expose service role to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Browser-safe values used only for Supabase Auth session handling in /admin.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=11111111-1111-4111-8111-111111111111

# 32+ random bytes. Base64 output from `openssl rand -base64 32` is accepted.
APP_ENCRYPTION_KEY=replace-with-32-byte-secret
SESSION_TOKEN_PEPPER=replace-with-independent-32-byte-secret

# Optional admin controls.
ADMIN_EMAIL_ALLOWLIST=admin@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
